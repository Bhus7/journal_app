@using JournalApp.Data
@using JournalApp.Data.Models
@using Microsoft.EntityFrameworkCore
@inject JournalApp.Services.TagService TagService

@page "/today"
@inject AppDbContext Db
@inject NavigationManager Nav

<div class="entry-page">
    <div class="entry-container">

        <!-- Header -->
        <div class="entry-header">
            <div>
                <h2 class="entry-title">Today's Journal Entry</h2>
                <div class="entry-subtitle">Write what happened today — moods + tags help you track patterns.</div>
            </div>

            <div class="entry-header-actions">
                <button type="button" class="btn btn-outline-secondary entry-btn" @onclick="GoToHistory">
                    View History
                </button>
            </div>
        </div>

        <!-- Main Card -->
        <div class="entry-card">
            <div class="entry-card-head">
                <div>
                    <div class="entry-card-title">Entry Details</div>
                    <div class="entry-card-sub">Title, content and moods</div>
                </div>

                @if (todayEntry != null)
                {
                    <span class="entry-badge">Saved for @SelectedDate.ToString("dd MMM yyyy")</span>
                }
                else
                {
                    <span class="entry-badge entry-badge-muted">New Entry for @SelectedDate.ToString("dd MMM yyyy")</span>
                }
            </div>

            <!-- Date picker -->
            <div class="mb-3">
                <label class="form-label entry-label">Entry date</label>
                <input type="date" class="form-control entry-input"
                       value="@SelectedDate.ToString("yyyy-MM-dd")"
                       @onchange="OnDateChanged" />
                <div class="entry-hint">Pick a date to add an entry.</div>
            </div>

            <!-- Title -->
            <div class="mb-3">
                <label class="form-label entry-label">Title</label>
                <input class="form-control entry-input"
                       @bind="Title"
                       placeholder="Enter a title..." />
            </div>

            <!-- Content -->
            <div class="mb-3">
                <label class="form-label entry-label">Content</label>
                <RichTextEditor @bind-Value="Content" Placeholder="Write your entry..." />
            </div>

            <!-- Mood Grid -->
            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <label class="form-label entry-label">
                        Primary Mood <span class="text-danger">*</span>
                    </label>
                    <select class="form-select entry-input" @bind="PrimaryMood">
                        <option value="">-- Select Primary Mood --</option>
                        @foreach (var mood in AllMoods)
                        {
                            <option value="@mood">@mood</option>
                        }
                    </select>
                    <div class="entry-hint">Required</div>
                </div>

                <div class="col-12 col-lg-6">
                    <label class="form-label entry-label">Secondary Mood (Optional)</label>
                    <select class="form-select entry-input" @bind="SecondaryMood1">
                        <option value="">-- Select Mood --</option>
                        @foreach (var mood in AllMoods)
                        {
                            <option value="@mood">@mood</option>
                        }
                    </select>
                    <div class="entry-hint">Optional</div>
                </div>
            </div>

            <!-- Tags -->
            <div class="mt-4">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                    <div>
                        <div class="entry-card-title">Tags</div>
                        <div class="entry-card-sub">Click to select. Add your own tag anytime.</div>
                    </div>
                    <div class="entry-count">
                        Selected: <strong>@selectedTagIds.Count</strong>
                    </div>
                </div>

                <div class="entry-tags mb-3">
                    @if (allTags.Count == 0)
                    {
                        <div class="text-muted">No tags available.</div>
                    }
                    else
                    {
                        @foreach (var tag in allTags)
                        {
                            var isSelected = selectedTagIds.Contains(tag.Id);

                            <button type="button"
                                    class="entry-tag @(isSelected ? "entry-tag-selected" : "")"
                                    @onclick="() => ToggleTag(tag.Id)">
                                @tag.Name
                            </button>
                        }
                    }
                </div>

                <div class="input-group entry-input-group">
                    <input class="form-control entry-input"
                           placeholder="Add a custom tag (e.g., Sleep)"
                           @bind="newTagName" />
                    <button class="btn btn-outline-secondary entry-btn" type="button" @onclick="AddCustomTag">
                        Add
                    </button>
                </div>
            </div>

            <!-- Actions -->
            <div class="entry-actions mt-4">
                <button class="btn btn-primary entry-save" @onclick="SaveEntry" disabled="@IsSaveDisabled()">
                    Save Entry
                </button>

                @if (todayEntry != null)
                {
                    <button class="btn btn-outline-danger entry-delete" @onclick="DeleteEntry">
                        Delete
                    </button>
                }
            </div>

            @if (IsSaveDisabled())
            {
                <div class="entry-warning mt-3">
                    Select a <strong>Primary Mood</strong> to enable saving.
                </div>
            }
        </div>

    </div>
</div>

@code {
    private string Title = "";
    private string Content = "";

    private string PrimaryMood = "";
    private string? SecondaryMood1;
    private string? SecondaryMood2;

    private DateOnly SelectedDate = DateOnly.FromDateTime(DateTime.Now);

    private List<Tag> allTags = new();
    private HashSet<int> selectedTagIds = new();
    private string newTagName = "";

    private List<string> AllMoods = new()
    {
        "Happy", "Excited", "Relaxed", "Grateful", "Confident", "Calm",
        "Thoughtful", "Curious", "Nostalgic", "Bored", "Sad", "Angry",
        "Stressed", "Lonely", "Anxious"
    };

    private JournalEntry? todayEntry;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntryForSelectedDateAsync();
        await LoadTagsAsync();
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            SelectedDate = d;
            await LoadEntryForSelectedDateAsync();
            await LoadTagsAsync();
            StateHasChanged();
        }
    }

    private async Task LoadTagsAsync()
    {
        allTags = await TagService.GetAllTagsAsync();

        if (todayEntry != null)
        {
            selectedTagIds = (await TagService.GetTagIdsForEntryAsync(todayEntry.Id)).ToHashSet();
        }
        else
        {
            selectedTagIds = new HashSet<int>();
        }
    }

    private Task LoadEntryForSelectedDateAsync()
    {
        // Don't load existing. Always start fresh for a new entry.
        ClearFormOnly();
        return Task.CompletedTask;
    }

    // This clears fields but keeps SelectedDate same
    private void ClearFormOnly()
    {
        Title = "";
        Content = "";
        PrimaryMood = "";
        SecondaryMood1 = null;
        SecondaryMood2 = null;
        selectedTagIds = new HashSet<int>();
        todayEntry = null;
    }

    private void ToggleTag(int tagId)
    {
        if (!selectedTagIds.Add(tagId))
            selectedTagIds.Remove(tagId);
    }

    private async Task AddCustomTag()
    {
        if (string.IsNullOrWhiteSpace(newTagName))
            return;

        var tag = await TagService.GetOrCreateTagAsync(newTagName);
        newTagName = "";

        allTags = await TagService.GetAllTagsAsync();
        selectedTagIds.Add(tag.Id);
    }

    private async Task SaveEntry()
    {
        if (string.IsNullOrWhiteSpace(PrimaryMood))
            return;

        var day = SelectedDate;

        if (todayEntry == null)
        {
            todayEntry = new JournalEntry
            {
                EntryDate = day,
                Title = Title,
                Content = Content,
                PrimaryMood = PrimaryMood,
                SecondaryMood1 = SecondaryMood1,
                SecondaryMood2 = SecondaryMood2,
                CreatedAt = DateTime.Now,
                UpdatedAt = DateTime.Now
            };

            Db.JournalEntries.Add(todayEntry);
        }
        else
        {
            todayEntry.Title = Title;
            todayEntry.Content = Content;
            todayEntry.PrimaryMood = PrimaryMood;
            todayEntry.SecondaryMood1 = SecondaryMood1;
            todayEntry.SecondaryMood2 = SecondaryMood2;
            todayEntry.UpdatedAt = DateTime.Now;
        }

        await Db.SaveChangesAsync();
        await TagService.SetTagsForEntryAsync(todayEntry!.Id, selectedTagIds);

        // THIS IS THE IMPORTANT PART: after save, clear details
        ClearFormOnly();
    }

    private async Task DeleteEntry()
    {
        if (todayEntry != null)
        {
            await TagService.SetTagsForEntryAsync(todayEntry.Id, Array.Empty<int>());

            Db.JournalEntries.Remove(todayEntry);
            await Db.SaveChangesAsync();

            ClearFormOnly();
        }
    }

    private bool IsSaveDisabled() => string.IsNullOrWhiteSpace(PrimaryMood);

    private void GoToHistory() => Nav.NavigateTo("/history");
}
