@page "/history"
@using JournalApp.Data
@using JournalApp.Data.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject JournalApp.Services.TagService TagService
@inject JournalApp.Services.PdfExportService PdfExportService

<h3>Journal History</h3>

<!-- Filters -->
<div class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-6">
            <label class="form-label">Search (title/content)</label>
            <input class="form-control"
                   placeholder="Type to search..."
                   @bind="SearchText"
                   @bind:event="oninput" />
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label">Primary Mood</label>
            <select class="form-select" @bind="SelectedMood">
                <option value="">All moods</option>
                @foreach (var mood in AllMoods)
                {
                    <option value="@mood">@mood</option>
                }
            </select>
        </div>

        <div class="col-12 col-md-3 d-grid">
            <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                Clear
            </button>
        </div>
    </div>

    <!-- Date range filter -->
    <div class="row g-2 mt-3">
        <div class="col-12 col-md-6">
            <label class="form-label">Start Date</label>
            <input type="date"
                   class="form-control"
                   value="@StartDateValue"
                   @onchange="OnStartDateChanged" />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label">End Date</label>
            <input type="date"
                   class="form-control"
                   value="@EndDateValue"
                   @onchange="OnEndDateChanged" />
        </div>
    </div>

    <!-- Tags Filter -->
    <div class="mt-3">
        <label class="form-label">Filter by Tags</label>

        @if (allTags.Count == 0)
        {
            <div class="text-muted">No tags available.</div>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var tag in allTags)
                {
                    var selected = selectedTagIds.Contains(tag.Id);

                    <button type="button"
                            class="btn btn-sm @(selected ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => ToggleTag(tag.Id)">
                        @tag.Name
                    </button>
                }
            </div>
        }
    </div>
</div>

@if (entries == null)
{
    <p>Loading...</p>
}
else if (entries.Count == 0)
{
    <p class="text-muted">No entries match your filters.</p>
}
else
{
    <div class="list-group mb-3">
        @foreach (var entry in entries)
        {
            <a class="list-group-item list-group-item-action"
               href="/entry/@entry.Id"
               style="cursor:pointer; text-decoration:none; color:inherit;">

                <div class="d-flex justify-content-between">
                    <strong>@entry.EntryDate.ToString("dd MMM yyyy")</strong>
                    <span class="badge bg-primary">@entry.PrimaryMood</span>
                </div>

                <div class="fw-semibold">@entry.Title</div>
                <div class="text-muted">@Shorten(entry.Content, 120)</div>

                @if (entry.JournalEntryTags != null && entry.JournalEntryTags.Count > 0)
                {
                    <div class="mt-2 d-flex flex-wrap gap-1">
                        @foreach (var jt in entry.JournalEntryTags)
                        {
                            <span class="badge bg-secondary">@jt.Tag.Name</span>
                        }
                    </div>
                }
            </a>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <button class="btn btn-outline-primary"
                disabled="@(currentPageNumber == 1)"
                @onclick="PrevPage">
            Previous
        </button>

        <span>@($"Page {currentPageNumber}")</span>

        <button class="btn btn-outline-primary"
                disabled="@(!hasMore)"
                @onclick="NextPage">
            Next
        </button>
    </div>

    <div class="d-flex justify-content-end">
        <button class="btn btn-outline-success" @onclick="ExportAllHistory">
            Export All
        </button>
    </div>
}

@code {
    private List<JournalEntry>? entries;

    private int currentPageNumber = 1;
    private const int PageSize = 5;
    private bool hasMore;

    // Filters
    private string searchText = "";
    private string selectedMood = "";

    // Date range filters
    private DateOnly? StartDate;
    private DateOnly? EndDate;

    // Tag filter
    private List<Tag> allTags = new();
    private HashSet<int> selectedTagIds = new();

    private readonly List<string> AllMoods = new()
    {
        "Happy","Excited","Relaxed","Grateful","Confident","Calm","Thoughtful",
        "Curious","Nostalgic","Bored","Sad","Angry","Stressed","Lonely","Anxious"
    };

    protected override async Task OnInitializedAsync()
    {
        allTags = await TagService.GetAllTagsAsync();
        await LoadEntriesAsync();
    }

    // These two properties help show the date in the input (or blank if null)
    private string StartDateValue => StartDate?.ToString("yyyy-MM-dd") ?? "";
    private string EndDateValue => EndDate?.ToString("yyyy-MM-dd") ?? "";

    private async Task OnStartDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
            StartDate = d;
        else
            StartDate = null;

        await RefreshFromFilters();
    }

    private async Task OnEndDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
            EndDate = d;
        else
            EndDate = null;

        await RefreshFromFilters();
    }

    private async Task LoadEntriesAsync()
    {
        var query = Db.JournalEntries
            .AsNoTracking()
            .Include(e => e.JournalEntryTags)
                .ThenInclude(jt => jt.Tag)
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(selectedMood))
        {
            query = query.Where(e => e.PrimaryMood == selectedMood);
        }

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var s = searchText.Trim();
            query = query.Where(e =>
                (e.Title != null && EF.Functions.Like(e.Title, $"%{s}%")) ||
                (e.Content != null && EF.Functions.Like(e.Content, $"%{s}%")));
        }

        if (StartDate != null)
        {
            query = query.Where(e => e.EntryDate >= StartDate.Value);
        }

        if (EndDate != null)
        {
            query = query.Where(e => e.EntryDate <= EndDate.Value);
        }

        if (selectedTagIds.Count > 0)
        {
            query = query.Where(e =>
                e.JournalEntryTags.Any(jt => selectedTagIds.Contains(jt.TagId)));
        }

        // newest saved/edited first
        query = query
            .OrderByDescending(e => e.UpdatedAt)
            .ThenByDescending(e => e.EntryDate);

        var totalCount = await query.CountAsync();

        entries = await query
            .Skip((currentPageNumber - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();

        hasMore = totalCount > currentPageNumber * PageSize;
    }

    private async Task ExportAllHistory()
    {
        var all = await Db.JournalEntries
            .AsNoTracking()
            .Include(e => e.JournalEntryTags)
                .ThenInclude(jt => jt.Tag)
            .ToListAsync();

        var path = PdfExportService.ExportAllEntriesToPdf(all);

        await Launcher.OpenAsync(new OpenFileRequest
        {
            File = new ReadOnlyFile(path)
        });
    }

    private async Task NextPage()
    {
        currentPageNumber++;
        await LoadEntriesAsync();
    }

    private async Task PrevPage()
    {
        if (currentPageNumber > 1)
        {
            currentPageNumber--;
            await LoadEntriesAsync();
        }
    }

    private void ToggleTag(int tagId)
    {
        if (!selectedTagIds.Add(tagId))
            selectedTagIds.Remove(tagId);

        _ = RefreshFromFilters();
    }

    private async Task ClearFilters()
    {
        searchText = "";
        selectedMood = "";
        StartDate = null;
        EndDate = null;
        selectedTagIds.Clear();
        currentPageNumber = 1;
        await LoadEntriesAsync();
    }

    private async Task RefreshFromFilters()
    {
        currentPageNumber = 1;
        await LoadEntriesAsync();
    }

    private static string Shorten(string? text, int max)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        text = text.Trim();
        return text.Length <= max ? text : text.Substring(0, max) + "...";
    }

    private string SearchText
    {
        get => searchText;
        set
        {
            searchText = value;
            _ = RefreshFromFilters();
        }
    }

    private string SelectedMood
    {
        get => selectedMood;
        set
        {
            selectedMood = value;
            _ = RefreshFromFilters();
        }
    }
}
