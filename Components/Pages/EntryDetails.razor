@page "/entry/{Id:int}"
@using JournalApp.Data
@using JournalApp.Data.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Nav

<h3>Journal Entry</h3>

@if (entry == null)
{
    <p class="text-muted">Loading entry...</p>
}
else
{
    <div class="card p-4">

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">@entry.EntryDate.ToString("dddd, dd MMMM yyyy")</h5>
            <span class="badge bg-primary fs-6">@entry.PrimaryMood</span>
        </div>

        <h4 class="mt-3">@entry.Title</h4>

        <p class="mt-3" style="white-space: pre-wrap;">@entry.Content</p>

        @if (!string.IsNullOrWhiteSpace(entry.SecondaryMood1))
        {
            <p><strong>Secondary mood:</strong> @entry.SecondaryMood1</p>
        }

        @if (!string.IsNullOrWhiteSpace(entry.SecondaryMood2))
        {
            <p><strong>Secondary mood 2:</strong> @entry.SecondaryMood2</p>
        }

        @if (entry.JournalEntryTags?.Count > 0)
        {
            <div class="mt-3">
                <strong>Tags:</strong>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    @foreach (var jt in entry.JournalEntryTags)
                    {
                        <span class="badge bg-secondary">@jt.Tag.Name</span>
                    }
                </div>
            </div>
        }

        <div class="mt-4 d-flex justify-content-between">
            <button class="btn btn-outline-secondary" @onclick="GoBack">
                ← Back
            </button>

            <button class="btn btn-outline-danger" @onclick="DeleteEntry">
                Delete
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private JournalEntry? entry;

    protected override async Task OnInitializedAsync()
    {
        entry = await Db.JournalEntries
            .Include(e => e.JournalEntryTags)
                .ThenInclude(jt => jt.Tag)
            .FirstOrDefaultAsync(e => e.Id == Id);
    }

    private void GoBack()
    {
        Nav.NavigateTo("/history");
    }

    private async Task DeleteEntry()
    {
        if (entry != null)
        {
            Db.JournalEntries.Remove(entry);
            await Db.SaveChangesAsync();
            Nav.NavigateTo("/history", true);
        }
    }
}
