@page "/settings"
@using JournalApp.Services
@inject ThemeState Theme
@inject AuthState Auth
@inject NavigationManager Nav

<h2 class="fw-bold mb-4">SETTINGS</h2>

<div class="row g-4">

    <div class="col-12 col-lg-7">
        <div class="text-uppercase text-muted small fw-semibold mb-2">Account</div>

        <div class="card shadow-sm" style="border-radius: 14px;">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:40px;height:40px;background:#f1f3f5;">
                        <span class="bi bi-person"></span>
                    </div>

                    <div>
                        <div class="fw-semibold">Profile</div>
                        <div class="text-muted small">Personal details</div>
                    </div>
                </div>

                <button class="btn btn-sm btn-outline-secondary" disabled>Open</button>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="text-uppercase text-muted small fw-semibold mb-2">Experience</div>

        <div class="card shadow-sm" style="border-radius: 14px;">
            <div class="card-body p-0">

                <div class="p-3 d-flex align-items-center justify-content-between border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:40px;height:40px;background:#f1f3f5;">
                            <span class="bi bi-moon"></span>
                        </div>

                        <div>
                            <div class="fw-semibold">Appearance</div>
                            <div class="text-muted small">Toggle dark and light modes</div>
                        </div>
                    </div>

                    <div class="form-check form-switch m-0">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               checked="@Theme.IsDark"
                               @onchange="OnThemeToggle" />
                    </div>
                </div>

                <div class="p-3 d-flex align-items-center justify-content-between border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:40px;height:40px;background:#f1f3f5;">
                            <span class="bi bi-bell"></span>
                        </div>

                        <div>
                            <div class="fw-semibold">Notifications</div>
                            <div class="text-muted small">Daily writing reminders</div>
                        </div>
                    </div>

                    <button class="btn btn-sm btn-outline-secondary" disabled>Coming</button>
                </div>

                <div class="p-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:40px;height:40px;background:#f1f3f5;">
                            <span class="bi bi-shield-lock"></span>
                        </div>

                        <div>
                            <div class="fw-semibold">Privacy</div>
                            <div class="text-muted small">App lock and security</div>
                        </div>
                    </div>

                    <button class="btn btn-sm btn-outline-secondary" disabled>View</button>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4" style="border-radius: 14px; border: 1px solid #f5c2c7;">
    <div class="card-body d-flex align-items-center justify-content-between" style="background:#fff5f5;">
        <div>
            <div class="text-danger fw-bold">DANGER ZONE</div>
            <div class="text-muted small">Permanently delete your account and all entries.</div>
        </div>

        <button class="btn btn-danger" disabled>DELETE DATA</button>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/login", true);
        }
    }

    private void OnThemeToggle(ChangeEventArgs e)
    {
        Theme.Toggle();
    }
}
