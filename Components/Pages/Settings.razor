@page "/settings"
@using JournalApp.Services
@using JournalApp.Security
@using JournalApp.Data
@using JournalApp.Data.Models
@using Microsoft.EntityFrameworkCore
@inject ThemeState Theme
@inject AuthState Auth
@inject NavigationManager Nav
@inject AppDbContext Db

<h2 class="fw-bold mb-4">SETTINGS</h2>

<div class="row g-4">

    <!-- ACCOUNT -->
    <div class="col-12 col-lg-7">
        <div class="text-uppercase text-muted small fw-semibold mb-2">Account</div>

        <div class="card shadow-sm" style="border-radius: 14px;">
            <div class="card-body p-0">

                <!-- Change PIN -->
                <div class="p-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:40px;height:40px;background:#f1f3f5;">
                            <span class="bi bi-key"></span>
                        </div>

                        <div>
                            <div class="fw-semibold">Change PIN</div>
                            <div class="text-muted small">Update your login PIN</div>
                        </div>
                    </div>

                    <button class="btn btn-sm btn-outline-secondary" @onclick="TogglePinForm">
                        @(showPinForm ? "Close" : "Open")
                    </button>
                </div>

                @if (showPinForm)
                {
                    <div class="px-3 pb-3">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Current PIN</label>
                                <input class="form-control entry-input" type="password" @bind="currentPin" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">New PIN</label>
                                <input class="form-control entry-input" type="password" @bind="newPin" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Confirm PIN</label>
                                <input class="form-control entry-input" type="password" @bind="confirmPin" />
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(pinMessage))
                        {
                            <div class="mt-3 alert @(pinIsError ? "alert-danger" : "alert-success") mb-0">
                                @pinMessage
                            </div>
                        }

                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button class="btn btn-outline-secondary" @onclick="CancelPinChange">Cancel</button>
                            <button class="btn btn-primary" @onclick="SaveNewPin" disabled="@IsPinSaveDisabled()">
                                Save
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- EXPERIENCE -->
    <div class="col-12 col-lg-5">
        <div class="text-uppercase text-muted small fw-semibold mb-2">Experience</div>

        <div class="card shadow-sm" style="border-radius: 14px;">
            <div class="card-body p-0">

                <!-- Appearance -->
                <div class="p-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:40px;height:40px;background:#f1f3f5;">
                            <span class="bi bi-moon"></span>
                        </div>

                        <div>
                            <div class="fw-semibold">Appearance</div>
                            <div class="text-muted small">Toggle dark and light modes</div>
                        </div>
                    </div>

                    <div class="form-check form-switch m-0">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               checked="@Theme.IsDark"
                               @onchange="OnThemeToggle" />
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    private bool showPinForm = false;

    private string currentPin = "";
    private string newPin = "";
    private string confirmPin = "";

    private string pinMessage = "";
    private bool pinIsError = false;

    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/login", true);
        }
    }

    private void OnThemeToggle(ChangeEventArgs e) => Theme.Toggle();

    private void TogglePinForm()
    {
        showPinForm = !showPinForm;
        pinMessage = "";
        pinIsError = false;
    }

    private bool IsPinSaveDisabled()
        => string.IsNullOrWhiteSpace(currentPin)
        || string.IsNullOrWhiteSpace(newPin)
        || string.IsNullOrWhiteSpace(confirmPin);

    private void CancelPinChange()
    {
        currentPin = "";
        newPin = "";
        confirmPin = "";
        pinMessage = "";
        pinIsError = false;
        showPinForm = false;
    }

    private async Task SaveNewPin()
    {
        try
        {
            pinMessage = "";
            pinIsError = false;

            if (newPin != confirmPin)
            {
                pinMessage = "New PIN and confirmation do not match.";
                pinIsError = true;
                return;
            }

            if (newPin.Length < 4)
            {
                pinMessage = "PIN must be at least 4 characters.";
                pinIsError = true;
                return;
            }

            var user = await Db.Users.FirstOrDefaultAsync(u => u.Id == Auth.UserId);
            if (user == null)
            {
                pinMessage = "User not found.";
                pinIsError = true;
                return;
            }

            var ok = PinHasher.VerifyPin(currentPin, user.PinHash, user.Salt);
            if (!ok)
            {
                pinMessage = "Current PIN is incorrect.";
                pinIsError = true;
                return;
            }

            var newSalt = PinHasher.CreateSalt();
            var newHash = PinHasher.CreatePinHash(newPin, newSalt);

            user.Salt = newSalt;
            user.PinHash = newHash;

            await Db.SaveChangesAsync();

            pinMessage = "PIN updated successfully.";
            pinIsError = false;

            currentPin = "";
            newPin = "";
            confirmPin = "";
        }
        catch (Exception)
        {
            pinMessage = "An unexpected error occurred while updating the PIN. Please try again.";
            pinIsError = true;
        }
    }
}
